{
  "display_information": {
    "name": "SjangLab Authentik Login",
    "description": "Slack OAuth/OIDC login source for SjangLab Authentik"
  },
  "features": {
    "bot_user": {
      "display_name": "authentik-onboard",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/onboard",
        "url": "https://auth.sjanglab.org/slack/onboard",
        "description": "Create or link your SjangLab account",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://auth.sjanglab.org/source/oauth/callback/slack/"
    ],
    "scopes": {
      "bot": [
        "commands"
      ],
      "user": [
        "openid",
        "email",
        "profile"
      ]
    }
  },
  "settings": {
    "is_mcp_enabled": false,
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
